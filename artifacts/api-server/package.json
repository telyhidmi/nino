{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:posts && pnpm run test:live && pnpm run test:messaging",
    "test:messaging": "esbuild src/lib/messaging.test.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=/tmp/nino-messaging.test.cjs && node --test /tmp/nino-messaging.test.cjs",
    "test:posts": "esbuild src/lib/posts.test.ts src/lib/videoPlayback.test.ts --bundle --platform=node --format=cjs --external:pg-native --outdir=/tmp/nino-post-tests && node --test /tmp/nino-post-tests/posts.test.js /tmp/nino-post-tests/videoPlayback.test.js",
    "test:live": "esbuild src/lib/live.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/nino-live.test.cjs && node --test /tmp/nino-live.test.cjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.72",
    "@clerk/shared": "^4.36.0",
    "@google-cloud/storage": "^7.19.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "http-proxy-middleware": "^4.2.0",
    "livekit-server-sdk": "^2.19.1",
    "openai": "^7.30.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
